NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=csv_manager
DB_USER=csv_user
DB_PASSWORD=csv_password

# JWT
JWT_SECRET=change_this_super_secret_value_in_production
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# Carga de archivos
MAX_FILE_SIZE_MB=5

# Almacenamiento S3 (por defecto: AWS real)
# Credenciales de un IAM user/role con permisos s3:PutObject, s3:GetObject,
# s3:DeleteObject (y s3:HeadBucket/s3:CreateBucket si quieres que el backend
# cree el bucket automaticamente cuando no existe).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=csv-manager-documents
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Alternativa sin cuenta de AWS: LocalStack ---
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# S3_ENDPOINT=http://localhost:4566
# S3_FORCE_PATH_STYLE=true
