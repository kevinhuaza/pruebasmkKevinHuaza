# Copiar este archivo a ".env" (en la raiz) y ajustar los valores.
# El archivo ".env" NUNCA debe subirse al repositorio (ver .gitignore).

DB_NAME=csv_manager
DB_USER=csv_user
DB_PASSWORD=change_this_password
DB_HOST_PORT=5433

# Debe ser un valor largo, aleatorio y unico por entorno.
JWT_SECRET=change_this_super_secret_value_in_production
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=5

# ---------------------------------------------------------------------------
# Almacenamiento de documentos CSV
# ---------------------------------------------------------------------------
# 'local' (por defecto): los CSV se guardan en un volumen de Docker
# (uploads/), sin ninguna configuracion adicional ni cuenta de AWS.
STORAGE_DRIVER=local

# ---------------------------------------------------------------------------
# Alternativa: Amazon S3 real (STORAGE_DRIVER=s3)
# ---------------------------------------------------------------------------
# El backend crea el bucket solo si no existe todavia (ensureBucketExists).
# Credenciales de un IAM user/role con permisos:
#   s3:PutObject, s3:GetObject, s3:DeleteObject
#   s3:HeadBucket, s3:CreateBucket (opcionales, solo para la creacion automatica)
#
# STORAGE_DRIVER=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=csv-manager-documents
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Alternativa: S3 emulado con LocalStack, sin cuenta de AWS (STORAGE_DRIVER=s3)
# ---------------------------------------------------------------------------
# 1. Descomentar STORAGE_DRIVER=s3 de arriba y las 2 lineas de abajo
#    (AWS_ACCESS_KEY_ID/SECRET pueden quedar en cualquier valor, ej. "test").
# 2. Levantar el stack con: docker compose --profile local up --build
#
# S3_ENDPOINT=http://localstack:4566
# S3_FORCE_PATH_STYLE=true
